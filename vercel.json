{
  "framework": null,
  "installCommand": "true",
  "buildCommand": "node vercel-unpack.mjs",
  "outputDirectory": "_site",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/wealth-blueprint",
      "destination": "/tools/wealth-blueprint.html",
      "permanent": true
    },
    {
      "source": "/wealth-blueprint.html",
      "destination": "/tools/wealth-blueprint.html",
      "permanent": true
    },
    {
      "source": "/tools/wealth-blueprint",
      "destination": "/tools/wealth-blueprint.html",
      "permanent": true
    },
    {
      "source": "/spend-elon-money",
      "destination": "/spend-elon-money.html",
      "permanent": true
    },
    {
      "source": "/articles",
      "destination": "/articles.html",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contact.html",
      "permanent": true
    },
    {
      "source": "/analysis",
      "destination": "/analysis.html",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms.html",
      "permanent": true
    },
    {
      "source": "/disclaimer",
      "destination": "/disclaimer.html",
      "permanent": true
    },
    {
      "source": "/:slug-net-worth.html",
      "destination": "/profiles/:slug.html",
      "permanent": true
    },
    {
      "source": "/:slug-net-worth",
      "destination": "/profiles/:slug.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/data/billionaires.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
